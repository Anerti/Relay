		{"id":"ddc1377279603375","type":"text","text":"# agent_message\n\n- `id uuid pk default gen_random_uuid()`\n- `conversation_id uuid fk references conversation(id) on delete cascade`\n- `issuer enum(agent, human) not null default human`\n- `content text not null`\n- `created_at timestamptz not null default now()`\n- `deleted_at timestamptz`\n- `updated_at timestamptz`\n","x":-1350,"y":-980,"width":780,"height":501},
		{"id":"7cfb907eaa549353","type":"text","text":"# message\n\n- `id uuid pk default gen_random_uuid()`\n- `sender_id   uuid fk references user(id) on delete set null`\n- `receiver_id uuid fk references user(id) on delete set null`\n- `reply_to uuid`\n- `issuer enum(agent, human) default human not null`\n- `content text not null`\n- `created_at timestamptz not null default now()`\n- `deleted_at timestamptz`\n- `updated_at timestamptz`\n","x":-2480,"y":904,"width":843,"height":501},
