{
	"nodes":[
		{"id":"42df9342fce866ab","type":"text","text":"# user\n\n- `id uuid pk default gen_random_uuid()`\n- `username varchar(50) not null`\n- `password varchar(255) not null`\n- `first_name varchar(100) not null`\n- `last_name varchar(100) not null`\n- `email varchar(100) not null`\n- `unique index (lower(username))`\n- `unique index (lower(email))`\n- `verified boolean not null default false`\n- `status enum(active, inactive, locked) not null default active`\n- `role enum(superuser, guest) not null default guest`\n- `created_at timestamptz not null default now()`\n- `updated_at timestamptz`\n","x":-280,"y":920,"width":666,"height":470},
		{"id":"9e789b8302a37566","type":"text","text":"# host\n\n- `id uuid pk default gen_random_uuid()`\n- `user_id uuid fk references user(id) on delete set null`\n- `ip_address inet not null`\n- `(user_id, ip_address) unique`\n- `status enum(authorized, banned) not null default authorized`\n- `last_seen_at timestamptz not null default now()`\n- `updated_at timestamptz`\n","x":1360,"y":920,"width":620,"height":470},
