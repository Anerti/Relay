		{"id":"2e7926e0f2384a22","type":"text","text":"# conversation\n\n- `id uuid pk default gen_random_uuid()`\n- `title varchar(100)`\n- `user_id uuid fk references user(id) on delete cascade`\n- `created_at timestamptz not null default now()`\n- `updated_at timestamptz`\n","x":-1350,"y":-31,"width":780,"height":480},
